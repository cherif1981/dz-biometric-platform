# ============================================
# DZ Biometric Platform — Environment Config
# ============================================
# ⚠️ انسخ هذا الملف إلى .env وعدّل القيم
# ⚠️ لا ترفع .env إلى GitHub أبدًا

# ---------- Security ----------
# إلزامي — استخدم سلسلة عشوائية 64+ حرفًا
# توليد: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Database ----------
POSTGRES_USER=dzuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dzbiometric

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- AI Service ----------
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT=60

# ---------- Application ----------
DEBUG=false
APP_NAME=DZ Biometric Platform

# ---------- Storage ----------
STORAGE_PATH=/app/storage

# ---------- CORS ----------
# مفصولة بفواصل — تُحوَّل إلى list في config.py
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
