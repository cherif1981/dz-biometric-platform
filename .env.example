# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL
POSTGRES_USER=dzuser
POSTGRES_PASSWORD=dzpass
POSTGRES_DB=dzbiometric
DATABASE_URL=postgresql://dzuser:dzpass@postgres:5432/dzbiometric

# Redis
REDIS_URL=redis://redis:6379/0

# AI Service
AI_SERVICE_URL=http://ai-service:8001

# Storage
STORAGE_PATH=/app/storage
LOG_LEVEL=info