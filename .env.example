# DZ Biometric Platform — Environment Configuration

# === Security (REQUIRED in production) ===
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Field encryption (REQUIRED in production) ===
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# === Environment ===
ENVIRONMENT=development
DEBUG=true

# === Database ===
DATABASE_URL=sqlite:///./dz_biometric.db
# DATABASE_URL=postgresql+asyncpg://dz_app:CHANGE_ME@localhost:5432/dz_biometric
REDIS_URL=redis://localhost:6379/0

# === ML thresholds ===
FACE_MATCH_THRESHOLD=0.40
LIVENESS_THRESHOLD=0.50
ANTISPOOF_THRESHOLD=0.45

# === CORS (empty = disabled) ===
CORS_ORIGINS=[]

# === Application users (JSON) ===
# Generate bcrypt hash:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YourPass!'))"
APP_USERS={}
