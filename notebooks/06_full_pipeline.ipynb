def verify_identity(card_image, selfie_image):

    card = detect_card(card_image)

    if not card["success"]:
        return {
            "success": False,
            "stage": "card_detection"
        }

    ocr = extract_identity(card["image"])

    face = verify_face(
        card["image"],
        selfie_image
    )

    liveness = check_liveness(
        selfie_image
    )

    return {
        "success": (
            ocr["success"]
            and face["verified"]
            and liveness["live"]
        ),
        "ocr": ocr,
        "face": face,
        "liveness": liveness
    }